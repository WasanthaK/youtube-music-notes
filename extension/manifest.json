{
  "manifest_version": 3,
  "name": "YouTube Music Notes",
  "version": "0.4.7",
  "description": "Capture a 30-second YouTube sample, transcribe guitar through the local Guitar Ear Phase-2d backend, retain the original audio locally for A/B comparison, and render playable TAB.",
  "permissions": ["activeTab", "tabCapture", "offscreen", "tabs", "scripting"],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://music.youtube.com/*",
    "https://unpkg.com/*",
    "https://kgoowanohmtprbwdokjd.supabase.co/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "background": {
    "service_worker": "service_worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "YouTube Music Notes"
  }
}
