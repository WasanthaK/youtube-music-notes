{
  "manifest_version": 3,
  "name": "YouTube Music Notes",
  "version": "0.5.7",
  "description": "Capture the first 90 seconds of a YouTube video, transcribe the guitar locally in Chrome, compare against the original audio, and render playable TAB.",
  "permissions": [
    "activeTab",
    "tabCapture",
    "offscreen",
    "tabs",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://music.youtube.com/*",
    "https://kgoowanohmtprbwdokjd.supabase.co/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "background": {
    "service_worker": "service_worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "YouTube Music Notes"
  }
}
